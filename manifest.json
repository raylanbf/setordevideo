{
  "manifest_version": 3,
  "name": "Setor de Vídeo — Canvas Studio",
  "description": "Mostra e copia o ID da coleção do Canvas Studio e a quantidade de vídeos, direto da página.",
  "version": "0.4.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "clipboardWrite"],
  "host_permissions": ["https://*.instructuremedia.com/*"],
  "content_scripts": [
    {
      "matches": ["https://*.instructuremedia.com/*"],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN",
      "js": ["src/net-hook.js"]
    },
    {
      "matches": ["https://*.instructuremedia.com/*"],
      "all_frames": true,
      "run_at": "document_idle",
      "js": ["src/studio.js"]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Setor de Vídeo — Studio",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
